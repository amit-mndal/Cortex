# ---- LLM (free) ----
# Get a free key at https://console.groq.com/keys (no card required)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- App ----
CHROMA_DB_PATH=./data/chroma
COLLECTION_NAME=cortex_docs
MAX_RETRIEVAL_RETRIES=2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173

# ---- Phase 3: async job queue ----
REDIS_URL=redis://localhost:6379/0

# ---- Phase 6: persistent eval storage ----
# Leave unset for local dev (defaults to SQLite, zero setup).
# In production, set to a Supabase/Render Postgres URL, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/postgres
DATABASE_URL=sqlite:///./data/cortex.db
